{
  "name": "operator-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operator — AI agent service with human field dispatch (Cloudflare Workers + D1 + R2)",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply operator-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply operator-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "better-auth": "1.7.14",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
